import java.io.File;
import java.io.IOException;

public class ThrowsException {
	
	public static void main(String[] args) throws IOException{
		// TODO Auto-generated method stub
		File f=new File("myfile");
		f.createNewFile();
		
		try {
			File f=new File("myfile");
			f.createNewFile();
			
		}catch(IOException e) {
			System.out.println("file is not found");
		}

	}
}
