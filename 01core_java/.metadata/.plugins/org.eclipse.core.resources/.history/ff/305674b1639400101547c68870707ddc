package UsingRunnable;

public class JoinMethod {
	public static void main(String[] args) {
		MyThread2 my= new MyThread2();
		Thread t=new Thread(my);
		t.start();
		
		try {
			t.join(1);
		}catch(InterruptedException e) {
			e.printStackTrace();
		}
		for(int i=1;i<=10;i++) {
		System.out.println("Parent thread"+i);
		}
	

}
	}
