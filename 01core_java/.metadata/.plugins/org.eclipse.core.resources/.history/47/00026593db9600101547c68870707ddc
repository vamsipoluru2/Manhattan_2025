class Outer {
    private class InnerPrivate { }
    protected class InnerProtected { }
    public class InnerPublic { }
    class InnerDefault { }  // default

    static class StaticInner {
        static String msg = "Hello from static inner";
    }
}

public class Accessmodifiers {
    public static void main(String[] args) {
        // Outer.InnerPrivate obj = new Outer().new InnerPrivate(); // ❌ cannot access (private)
        Outer.InnerPublic pub = new Outer().new InnerPublic(); // ✅ public is fine
        Outer.StaticInner si = new Outer.StaticInner();        // ✅ static inner
        System.out.println(Outer.StaticInner.msg);
    }
}

