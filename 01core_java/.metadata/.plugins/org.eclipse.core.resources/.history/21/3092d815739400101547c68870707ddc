			for(int i=1;i<10;i++) {
				System.out.println("Hi,i am at sysncronized block"+"From trainer"+trainerName+"PL");
				
				try{
					Thread.sleep(2000);
					}catch(Exception e) {
						e.printStackTrace();
					}
			}
			
		}
		System.out.println("Out of the Synchronization Block");
	}
	
}

