package Syncronization;


class Display {
	public void trainingRoom(String trainerName,String PL) {
		synchronized(this){
			for(int i=1;i<10;i++) {
				System.out.println("Hi,i am at sysncronized block"+"From trainer"+trainerName+"PL");
				
				try{
					Thread.sleep(2000);
					}catch(Exception e) {
						e.printStackTrace();
					}
			}
			
		}
		System.out.println("Out of the Synchronization Block");
	}
	
}

class MyThread extends Thread{
	
	
	String trainName;
	String PL;
	Display d;
	
	public MyThread(String trainName,String PL,Display d) {
		this.trainName=trainName;
		this.PL= PL;
		this.d=d;
	}
	
	public void run() {
		d.trainingRoom(trainName,PL);

	}
}
	
