	@Override
	public String toString() {
		return "Students [regNo=" + regNo + ", name=" + name + ", fee=" + fee + "]";
	}



                                                                                    
                                                                                            
                                                                                            
                                                                                            
                                                                                            
                                                                                            
	                                                                                        
	                                                                                        
	                                                                                        
	                                                                                        
	                                                                                        
	                                                                                        
                                                                                            
