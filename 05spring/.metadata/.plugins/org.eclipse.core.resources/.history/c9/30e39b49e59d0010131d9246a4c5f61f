	private String name;                                                                    
	private double fee;                                                                     
	                                                                                        
                                                                                                                                                                          
                                                                                            
                                                                                            
                                                                                            
	public Students(int regNo, String name, double fee) {
		super();
		this.regNo = regNo;
		this.name = name;
		this.fee = fee;
