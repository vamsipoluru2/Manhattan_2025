package com.manhatten.bean;

public class Student {
	private int RegNo;
	private String Name;
	private double Fee;
	
	public Student(int regNo, String name, double fee) {
		super();
		this.RegNo = regNo;
		this.Name = name;
		this.Fee = fee;
	}
	


	@Override
	public String toString() {
		return "Student [RegNo=" + RegNo + ", Name=" + Name + ", Fee=" + Fee + "]";
	}


	
	
	
	
	
	

}
