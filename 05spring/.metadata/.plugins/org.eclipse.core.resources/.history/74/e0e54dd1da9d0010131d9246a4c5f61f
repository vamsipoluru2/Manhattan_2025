
public class Student {
	private int RegNo;
	private String Name;
	private double Fee;
	
	public void setRegNo(int regNo) {
		RegNo = regNo;
	}
	
	public void setName(String name) {
		Name = name;
	}
	
	public void setFee(double fee) {
		Fee = fee;
	}

	@Override
	public String toString() {
		return "Student [RegNo=" + RegNo + ", Name=" + Name + ", Fee=" + Fee + "]";
	}
	
	
	
	
	
	

}
