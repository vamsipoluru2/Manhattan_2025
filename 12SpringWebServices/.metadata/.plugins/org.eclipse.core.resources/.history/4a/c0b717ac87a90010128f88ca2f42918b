package com.manhattan.rest;

import java.util.List;

import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.ResponseBody;
import org.springframework.web.bind.annotation.RestController;

import com.manhattan.SpringBootForPathVarApplication;
import com.manhattan.model.Book;

@RestController
@RequestMapping("/v2/app/book")
public class BookController {
	
	private final SpringBootForPathVarApplication myFirstSpringBootRestApiReqInputApplication;
	 
    public BookController(SpringBootForPathVarApplication requestExApplication) {
        this.myFirstSpringBootRestApiReqInputApplication = requestExApplication;
    }
 
    	@GetMapping("/fetch/{id}")
    	public @ResponseBody ResponseEntity<Book> fetchBook(@PathVariable Integer bid){
    		Book b = new Book(bid, "Java", 350.0);
    		return new ResponseEntity<Book>(b, HttpStatus.OK);
    	}
    	
    	@GetMapping("/fetch/id/{id}/name/{name}")
    	public @ResponseBody ResponseEntity<Book> fetchAllBooks(@PathVariable Integer bid, @PathVariable String bname){
    		Book b = new Book(bid, "Java", 350.0);
    		return new ResponseEntity<Book>(b, HttpStatus.OK);
    	}
    
     
}
